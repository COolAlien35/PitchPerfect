# =============================================================================
# PitchPerfect — Environment Variable Reference
# =============================================================================
# Copy this file to .env (gitignored) and fill in real values before running.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pitchperfect

# ─────────────────────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# JWT / SECURITY
# ─────────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your_very_long_random_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=pitchperfect-api
JWT_AUDIENCE=pitchperfect-frontend

# ─────────────────────────────────────────────────────────────────────────────
# AI / LLM SERVICES
# ─────────────────────────────────────────────────────────────────────────────
# Google Gemini (used for behavioral question generation & AI feedback)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (used for Whisper speech-to-text)
OPENAI_API_KEY=your_openai_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (Next.js — public vars are safe to expose to the browser)
# ─────────────────────────────────────────────────────────────────────────────
# FastAPI backend base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Node.js relay server (Socket.IO for real-time video/audio streaming)
NEXT_PUBLIC_WS_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL / SMTP (optional — for OTP verification)
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
FROM_EMAIL=noreply@pitchperfect.app

# ─────────────────────────────────────────────────────────────────────────────
# APP SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# ENVIRONMENT=production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
